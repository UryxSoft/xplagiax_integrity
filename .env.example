# XplagiaX Integrity — example configuration. Copy to .env and fill in.
# NEVER commit real values. In production inject these from a secret manager.

# development | testing | production. REQUIRED: the service refuses to start without it.
XI_ENV=development

# MySQL 8 via PyMySQL. Production refuses anything else.
XI_DATABASE_URL=mysql+pymysql://integrity:CHANGE_ME@127.0.0.1:3306/xplagiax_integrity?charset=utf8mb4

# HMAC pepper for service API keys (>= 32 chars, random). Rotating it invalidates all keys.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
XI_API_KEY_PEPPER=

# DEBUG | INFO | WARNING | ERROR  (DEBUG forbidden in production)
XI_LOG_LEVEL=INFO

# Max request body in bytes (default 16 MiB)
XI_MAX_REQUEST_BYTES=16777216

# DB pool per process. Total connections ~= workers * (pool_size + max_overflow).
XI_DB_POOL_SIZE=5
XI_DB_MAX_OVERFLOW=2
XI_DB_POOL_RECYCLE_S=1800
XI_DB_CONNECT_TIMEOUT_S=5
# Max seconds for a single DB read/write
XI_DB_IO_TIMEOUT_S=30

# --- Not used yet (documented so nobody invents their own names) ----------
# XI_VALKEY_URL=redis://127.0.0.1:6380/0        # Stage 3+: rate limiting / provider cache
# XI_QDRANT_URL=http://127.0.0.1:6333          # shared instance; dedicated collections per ADR
# XI_SEAWEEDFS_MASTER_URL=http://127.0.0.1:9333
# External provider credentials are configured per adapter in Stage 3; see docs/DATA_SOURCES.md.
